DATABASE_URL=local.db

# Public URL used by SvelteKit and server-side origin checks.
ORIGIN=http://localhost:5173

# Raw benchmark files are stored under this directory using their database IDs.
BENCHMARK_UPLOAD_DIR=uploads/benchmarks
# Must be slightly larger than MAX_BENCHMARK_TOTAL_SIZE in src/lib/benchmark.ts.
BODY_SIZE_LIMIT=40M

# Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=
MEILI_HOST=http://localhost:7700
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Five-field cron expression for importing updated games from IGDB.
# IGDB_IMPORT_CRON=0 0 * * *
# IANA time-zone name, defaults to the system time zone when unset.
# IGDB_IMPORT_TIME_ZONE=Europe/London

# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=

# When running behind a reverse proxy, set both values to trust the proxy's
# client-IP header only when the request comes directly from that proxy.
# CLIENT_IP_HEADER=X-Real-IP
# TRUSTED_PROXY_ADDRESS=127.0.0.1

# WebAuthn values must exactly match the public site URL in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=flightlesskiwi
WEBAUTHN_ORIGIN=http://localhost:5173

# OAuth providers are enabled when both values for a provider are set.
# Callback URLs use /auth/oauth/{provider}/callback on WEBAUTHN_ORIGIN.

# https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
# https://github.com/settings/developers
# You can use a "GitHub App" too but I don't see any reason other than
# you can put multiple callback URLs
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# https://docs.discord.com/developers/topics/oauth2
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=

# Can be the same as your IGDB ID/Secret
# https://dev.twitch.tv/docs/authentication/register-app
# TWITCH_OAUTH_CLIENT_ID=
# TWITCH_OAUTH_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Optional public contact address shown on the privacy page.
# CONTACT_EMAIL=
