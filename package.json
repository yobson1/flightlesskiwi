{
	"name": "flightlesskiwi",
	"author": {
		"name": "yobson",
		"email": "contact@yobson.xyz",
		"url": "https://yobson.xyz/"
	},
	"license": "AGPL-3.0-only",
	"private": true,
	"version": "1.5.2",
	"engines": {
		"bun": "1.4.x"
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --parallel dev:app dev:search",
		"dev:app": "bun --bun vite dev",
		"dev:search": "meilisearch",
		"build": "bun --bun vite build",
		"build:binary": "bun run build && cp -R drizzle build/drizzle && cd build && bun build --compile ../scripts/compile-entry.ts --asset ./client --asset ./drizzle --outfile ../flightlesskiwi",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:rsvelte": "svelte-kit sync && rsvelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"format": "bun --bun scripts/rsvelte-fmt.ts .",
		"format:check": "bun --bun scripts/rsvelte-fmt.ts --check .",
		"lint": "bun --bun scripts/rsvelte-fmt.ts --check . && oxlint . && rsvelte-lint src/",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "bun run scripts/migrate.ts",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@iconify-json/line-md": "^1.2.16",
		"@iconify-json/simple-icons": "^1.2.93",
		"@oxlint/plugins": "1.79.0",
		"@rsvelte/fmt": "^0.7.11",
		"@rsvelte/lint": "^0.10.17",
		"@rsvelte/svelte-check": "^0.5.19",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/qrcode": "^1.5.6",
		"better-sqlite3": "^13.0.3",
		"bun-types": "^1.4.0",
		"drizzle-kit": "^0.31.10",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"svelte": "^5.56.9",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@blobatar/svelte": "^2.3.1",
		"@humanspeak/svelte-markdown": "^1.8.7",
		"@humanspeak/svelte-virtual-list": "^0.5.14",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@scure/base": "^2.3.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"@sveltejs/kit": "next",
		"apicalypse": "^1.0.5",
		"bits-ui": "^2.19.0",
		"blobatar": "^2.3.1",
		"clsx": "^2.1.1",
		"cronstrue": "^3.24.0",
		"drizzle-orm": "^0.45.2",
		"echarts": "^6.1.0",
		"meilisearch": "^0.60.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.5",
		"openid-client": "^6.8.7",
		"otpauth": "^9.5.1",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "^1.4.2",
		"winston": "^3.19.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
