		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.8.5",
		"@humanspeak/svelte-virtual-list": "^0.5.13",
